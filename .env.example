# Existing Shopify variables remain unchanged.

# Public project URL shown on the Supabase project overview.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only secret from Supabase Settings > API Keys.
# Never expose this value to browser code or commit a real value to Git.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Shopify sessions use the same server-only Supabase connection on stateless
# hosts such as Render. No Render disk or separate database is required.

# Analytics database capacity routing. The default free-plan allowance is
# 500 MB, with new database-mode stores stopped at the selected 80% soft limit.
ANALYTICS_DATABASE_LIMIT_BYTES=500000000
ANALYTICS_DATABASE_SOFT_LIMIT_PERCENT=80

# Estimated fixed PostgreSQL/Supabase overhead used when reserving mature
# 18-month capacity for database-mode stores.
ANALYTICS_DATABASE_BASELINE_BYTES=15000000

# Private Supabase Storage bucket used by stores assigned to file_cache mode.
ANALYTICS_STORAGE_BUCKET=analytics-monthly-cache

# Protects the deployed daily-refresh endpoint. Use a random value with at
# least 24 characters and store the same value as a GitHub Actions secret.
ANALYTICS_CRON_SECRET=replace-with-a-long-random-server-secret

# Local store hour after which the daily current-month refresh becomes due.
ANALYTICS_DAILY_REFRESH_HOUR=5
